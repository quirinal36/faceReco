# Face and attendance data (privacy): deny every runtime artifact and selectively
# keep only documentation/directory placeholders. This also covers SQLite
# journals/WAL files, backups, temporary files, and future biometric formats.
backend/data/*
!backend/data/README.md
!backend/data/.gitkeep
!backend/data/embeddings/
!backend/data/faces/
backend/data/embeddings/*
backend/data/faces/*
!backend/data/embeddings/.gitkeep
!backend/data/faces/.gitkeep

