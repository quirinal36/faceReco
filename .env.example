# Documentation template only. FaceReco does not load this file automatically.
# CHANGEME is intentionally too short for startup validation. Generate two
# DIFFERENT cryptographically random values of at least 32 characters, or use the
# protected *_FILE settings described in docs/SECURITY.md. Never commit .env.
FACERECO_OPERATOR_TOKEN=CHANGEME
FACERECO_DEVICE_TOKEN=CHANGEME

# Direct token values are for local development only. Production requires both
# protected *_FILE settings. Configure one source per role, never both.
# FACERECO_OPERATOR_TOKEN_FILE=/absolute/protected/path/operator.token
# FACERECO_DEVICE_TOKEN_FILE=/absolute/protected/path/device.token

# Development is still loopback-only by default.
FACERECO_ENV=development
FACERECO_BIND_HOST=127.0.0.1
FACERECO_ALLOW_NON_LOOPBACK=false
FACERECO_CORS_ORIGINS=https://127.0.0.1:5173
FACERECO_RELOAD=false

# Pre-provision $ROOT/models/$NAME/*.onnx; production must not download models.
FACERECO_MODEL_ROOT=/absolute/path/to/verified/insightface-root
FACERECO_MODEL_NAME=buffalo_l

# Local biometric inference is CUDA-only. Verify CUDAExecutionProvider before
# starting the server; do not use a CPU fallback for the live camera workload.
FACERECO_DEVICE=cuda

# This is an attestation, not an encryption control. Production requires true
# only after the actual data and backup paths are verified on LUKS2/BitLocker.
FACERECO_ENCRYPTED_STORAGE_VERIFIED=false

# Server-side only. Never use a VITE_* name for this credential.
EDU_MANAGER_API_BASE_URL=https://edu-manager-api.vercel.app
# EDU_MANAGER_API_KEY=replace-with-the-managed-rest-api-key
EDU_MANAGER_ATTENDANCE_VALUE=출석
