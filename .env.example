# ===== edu-manager API 연동 =====
# 값을 채운 뒤 이 파일을 .env 로 복사해서 사용하세요. (.env 는 git 에 커밋되지 않습니다)

# --- 읽기 API (Bearer 인증) ---
# 출석 명단/학생 조회용. https://edu-manager-api.vercel.app
EDU_API_BASE_URL=https://edu-manager-api.vercel.app
# 모든 /api/v1/* 요청에 X-Organization-Id 헤더로 전송
EDU_ORG_ID=

# --- 토큰 발급 (Supabase password grant, 1시간 만료 → 자동 refresh) ---
EDU_SUPABASE_URL=
EDU_SUPABASE_ANON_KEY=
EDU_LOGIN_EMAIL=
EDU_LOGIN_PASSWORD=

# --- 체크인 전송 (HMAC-SHA256 서명, /internal/face/check-ins) ---
# 서버 관리자에게 발급받은 웹훅 시크릿
FACE_CHECKIN_WEBHOOK_SECRET=
# 이 단말을 식별하는 ID (payload 의 device_id 및 idempotency_key 에 사용)
FACE_DEVICE_ID=jetson-01

# --- 동작 설정 ---
# false 로 두면 외부 API 연동 없이 기존 로컬 전용 모드로 동작
CHECKIN_ENABLED=true
# 오늘 출석 명단 재조회 주기(초)
ROSTER_REFRESH_SEC=60
# 출석 확인 모달 자동 닫힘 시간(초)
PROMPT_TIMEOUT_SEC=20
# "아니오" 선택 후 같은 사람에게 다시 묻기까지의 대기 시간(초)
PROMPT_COOLDOWN_SEC=300
